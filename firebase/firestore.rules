rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function isAdmin(){
      return signedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.active == true;
    }
    function validMeta(){
      return request.resource.data.keys().hasAll(['published','updatedAt','updatedBy'])
        && request.resource.data.published is bool
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }
    match /adminUsers/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /siteContent/{id} {
      allow get: if isAdmin() || (id == 'company' && resource.data.published == true);
      allow list: if false;
      allow create, update: if id == 'company' && isAdmin() && validMeta()
        && request.resource.data.keys().hasOnly(['published','updatedAt','updatedBy','heroLead','heroBangla','aboutIntro','contactEmail','contactPhone'])
        && request.resource.data.keys().hasAll(['heroLead','heroBangla','aboutIntro','contactEmail','contactPhone'])
        && request.resource.data.heroLead is string && request.resource.data.heroLead.size() <= 700
        && request.resource.data.heroBangla is string && request.resource.data.heroBangla.size() <= 250
        && request.resource.data.aboutIntro is string && request.resource.data.aboutIntro.size() <= 900
        && request.resource.data.contactEmail is string && request.resource.data.contactEmail.size() <= 160
        && request.resource.data.contactPhone is string && request.resource.data.contactPhone.size() <= 120;
      allow delete: if false;
    }
    match /products/{productId} {
      allow get: if isAdmin() || resource.data.published == true;
      allow list: if false;
      allow create, update: if productId in ['aeroplane-alkatra','urojahaj-alkatra','orbit-steel-care']
        && isAdmin() && validMeta()
        && request.resource.data.keys().hasOnly(['published','updatedAt','updatedBy','summary','description'])
        && request.resource.data.keys().hasAll(['summary','description'])
        && request.resource.data.summary is string && request.resource.data.summary.size() <= 300
        && request.resource.data.description is string && request.resource.data.description.size() <= 1200;
      allow delete: if false;
    }
    match /{document=**} { allow read,write: if false; }
  }
}
